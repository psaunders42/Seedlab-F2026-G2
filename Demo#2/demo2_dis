import cv2
import cv2.aruco as aruco
import numpy as np
import pickle
import time
import threading
import queue
from smbus import SMBus
import board
import adafruit_character_lcd.character_lcd_rgb_i2c as character_lcd


# --------------------------------------------------
# CALIBRATION - MATCH CAMERA SETTINGS USED TO CALIBRATE
# --------------------------------------------------
with open("calibration_improved.pkl", "rb") as f:
    camera_matrix, dist_coeffs = pickle.load(f)


camera_matrix = np.asarray(camera_matrix, dtype=np.float64)
dist_coeffs = np.asarray(dist_coeffs, dtype=np.float64)
optical_cx = float(camera_matrix[0, 2])
optical_cy = float(camera_matrix[1, 2])


# --------------------------------------------------
# SETTINGS
# --------------------------------------------------
TARGET_ID = 0
ARUCO_DICT = aruco.DICT_6X6_50
DEADBAND_PX = 15
ANGLE_THRESHOLD = 0.25        # Threshold for sending angle updates to Arduino
ANGLE_ALPHA = 0.25            # Angle EMA weight; lower = more smoothing
DISTANCE_ALPHA = 0.30         # NEW: Distance EMA weight


# NEW: Measure the side of the *black ArUco marker square*, not paper/margin.
# Earlier marker was about 2 x 2 inches; replace with the ACTUAL measurement.
MARKER_SIZE_IN = 2.0
INCHES_PER_METER = 39.37007874015748
MARKER_SIZE_M = MARKER_SIZE_IN / INCHES_PER_METER


# NEW: Display-only indicator. Does NOT stop or drive the motors.
CLOSE_ENOUGH_IN = 18.0        # 1.5 ft


ARD_ADDR = 8
CMD_QUADRANT = 0x01
CMD_ANGLE = 0x02
QUADRANT_BITS = {
    "NE": (0, 0),
    "NW": (0, 1),
    "SW": (1, 1),
    "SE": (1, 0),
}


# --------------------------------------------------
# NEW: 3D COORDINATES OF MARKER CORNERS, IN METERS
# Matches ArUco corner order: TL, TR, BR, BL.
# This is the documented SOLVEPNP_IPPE_SQUARE object-point order.
# --------------------------------------------------
half_size = MARKER_SIZE_M / 2.0
marker_object_points = np.array(
    [
        [-half_size,  half_size, 0.0],
        [ half_size,  half_size, 0.0],
        [ half_size, -half_size, 0.0],
        [-half_size, -half_size, 0.0],
    ],
    dtype=np.float32,
)


# --------------------------------------------------
# LCD
# --------------------------------------------------
lcd_queue = queue.Queue(maxsize=1)




def two_line_lcd(line1, line2):
    """Format fixed-width rows so earlier characters are overwritten."""
    return f"{line1[:16]:<16}\n{line2[:16]:<16}"




def queue_lcd(message):
    """Only retain the newest LCD message (avoid display lag)."""
    try:
        if lcd_queue.full():
            lcd_queue.get_nowait()
        lcd_queue.put_nowait(message)
    except (queue.Full, queue.Empty):
        pass




def lcd_display():
    try:
        time.sleep(1)
        lcd = character_lcd.Character_LCD_RGB_I2C(board.I2C(), 16, 2)
        lcd.clear()
        lcd.color = [0, 0, 100]
        while True:
            lcd.message = lcd_queue.get()
    except Exception as e:
        print("LCD thread error:", e)




threading.Thread(target=lcd_display, daemon=True).start()
Arduino_bus = SMBus(1)


# --------------------------------------------------
# ARUCO DETECTION WITH SUBPIXEL CORNER REFINEMENT
# --------------------------------------------------
aruco_dict = aruco.getPredefinedDictionary(ARUCO_DICT)
if hasattr(aruco, "DetectorParameters"):
    detector_params = aruco.DetectorParameters()
else:
    detector_params = aruco.DetectorParameters_create()
detector_params.cornerRefinementMethod = aruco.CORNER_REFINE_SUBPIX


# --------------------------------------------------
# CAMERA SETUP - MUST MATCH CALIBRATION CAPTURE
# --------------------------------------------------
camera = cv2.VideoCapture("/dev/video0", cv2.CAP_V4L2)
camera.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*"MJPG"))
camera.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
camera.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)
camera.set(cv2.CAP_PROP_FPS, 30)


if not camera.isOpened():
    raise RuntimeError("Could not open /dev/video0")
actual_size = (int(camera.get(cv2.CAP_PROP_FRAME_WIDTH)),
               int(camera.get(cv2.CAP_PROP_FRAME_HEIGHT)))
print("Camera:", actual_size)
if actual_size != (1280, 720):
    camera.release()
    raise RuntimeError("Capture resolution differs from the expected 1280x720 mode!")
print(f"Using marker side length: {MARKER_SIZE_IN:.3f} inches")
print("NOTE: calibration_improved.pkl MUST be from this camera at 1280x720 "
      "with the same focus/zoom/sensor mode.")
print("DISTANCE IS DISPLAY ONLY: no automatic motor commands are sent.")
time.sleep(2)


last_quadrant = None
last_sent_angle = None
last_lcd_time = 0.0
last_ard_angle_time = 0.0
last_print_time = 0.0
filtered_angle = None
filtered_distance_in = None  # NEW


# --------------------------------------------------
# MAIN LOOP
# --------------------------------------------------
try:
    while True:
        ok, frame = camera.read()
        if not ok:
            print("Camera frame failed")
            break


        # Detect on RAW frame. Undistort only point coordinates for bearing.
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        corners, ids, rejected = aruco.detectMarkers(
            gray, aruco_dict, parameters=detector_params
        )
        overlay = frame.copy()
        h, w = frame.shape[:2]
        cv2.line(overlay, (int(optical_cx), 0),
                 (int(optical_cx), h), (255, 255, 255), 1)
        cv2.line(overlay, (0, int(optical_cy)),
                 (w, int(optical_cy)), (255, 255, 255), 1)


        target_found = False
        if ids is not None:
            for marker_outline, marker_id in zip(corners, ids.flatten()):
                if int(marker_id) != TARGET_ID:
                    continue
                target_found = True


                # --------------------------------------------------
                # MARKER CENTER (KEEP SUBPIXEL PRECISION)
                # --------------------------------------------------
                raw_corners = marker_outline.reshape((4, 2)).astype(np.float32)
                center = raw_corners.mean(axis=0)
                center_x, center_y = float(center[0]), float(center[1])
                center_px = (int(round(center_x)), int(round(center_y)))
                dx = center_x - optical_cx
                dy = center_y - optical_cy


                # --------------------------------------------------
                # DISTORTION-CORRECTED HORIZONTAL BEARING (UNCHANGED)
                # --------------------------------------------------
                rays = cv2.undistortPoints(
                    raw_corners.reshape(-1, 1, 2), camera_matrix, dist_coeffs
                ).reshape(-1, 2)
                marker_ray_x = float(rays[:, 0].mean())
                raw_angle_deg = float(np.degrees(np.arctan2(-marker_ray_x, 1.0)))
                if filtered_angle is None:
                    filtered_angle = raw_angle_deg
                else:
                    filtered_angle += ANGLE_ALPHA * (raw_angle_deg - filtered_angle)
                angle_deg = filtered_angle


                # --------------------------------------------------
                # NEW: ESTIMATE 3D POSE AND DISTANCE TO MARKER CENTER
                # --------------------------------------------------
                # IPPE_SQUARE is designed for a single square planar marker.
                # Returns translation of marker CENTER in camera coordinates,
                # in the SAME units as marker_object_points (meters).
                pose_ok, rvec, tvec = cv2.solvePnP(
                    marker_object_points,
                    raw_corners,
                    camera_matrix,
                    dist_coeffs,
                    flags=cv2.SOLVEPNP_IPPE_SQUARE,
                )


                raw_distance_in = None
                forward_distance_in = None
                if pose_ok and np.all(np.isfinite(tvec)) and float(tvec[2, 0]) > 0:
                    raw_distance_m = float(np.linalg.norm(tvec))
                    raw_distance_in = raw_distance_m * INCHES_PER_METER
                    # Forward depth measured along the optical axis (not range).
                    forward_distance_in = float(tvec[2, 0]) * INCHES_PER_METER
                    if filtered_distance_in is None:
                        filtered_distance_in = raw_distance_in
                    else:
                        filtered_distance_in += DISTANCE_ALPHA * (
                            raw_distance_in - filtered_distance_in
                        )
                else:
                    filtered_distance_in = None


                # --------------------------------------------------
                # QUADRANT (UNCHANGED)
                # --------------------------------------------------
                if abs(dx) <= DEADBAND_PX or abs(dy) <= DEADBAND_PX:
                    quadrant = last_quadrant
                elif dx > 0 and dy < 0:
                    quadrant = "NE"
                elif dx < 0 and dy < 0:
                    quadrant = "NW"
                elif dx < 0 and dy > 0:
                    quadrant = "SW"
                else:
                    quadrant = "SE"


                if quadrant is not None and quadrant != last_quadrant:
                    left_bit, right_bit = QUADRANT_BITS[quadrant]
                    goal_byte = (left_bit << 1) | right_bit
                    try:
                        Arduino_bus.write_byte_data(ARD_ADDR, CMD_QUADRANT, goal_byte)
                        last_quadrant = quadrant
                        print("Quadrant:", quadrant, "sent:", goal_byte)
                    except OSError as e:
                        print("Failed to send quadrant:", e)


                # --------------------------------------------------
                # ANGLE TO ARDUINO (UNCHANGED)
                # --------------------------------------------------
                now = time.time()
                angle_changed = (last_sent_angle is None or
                                 abs(angle_deg - last_sent_angle) >= ANGLE_THRESHOLD)
                if now - last_ard_angle_time >= 0.1 and angle_changed:
                    angle_int = int(round(angle_deg * 100))
                    try:
                        Arduino_bus.write_word_data(
                            ARD_ADDR, CMD_ANGLE, angle_int & 0xFFFF
                        )
                        last_ard_angle_time = now
                        last_sent_angle = angle_deg
                    except OSError as e:
                        print("Failed to send angle:", e)


                # --------------------------------------------------
                # NEW: ANGLE + DISTANCE ON LCD (16x2)
                # --------------------------------------------------
                if now - last_lcd_time >= 0.25:
                    if filtered_distance_in is not None:
                        # Example: "A:+12.34 deg" / "D:58.1in 4.8ft"
                        line2 = (f"D:{filtered_distance_in:.1f}in "
                                 f"{filtered_distance_in / 12.0:.1f}ft")
                    else:
                        line2 = "D: unavailable"
                    queue_lcd(two_line_lcd(f"A:{angle_deg:+.2f} deg", line2))
                    last_lcd_time = now


                # --------------------------------------------------
                # NEW: DISTANCE ON CAMERA PREVIEW
                # --------------------------------------------------
                aruco.drawDetectedMarkers(overlay, [marker_outline],
                                          np.array([[marker_id]]))
                cv2.circle(overlay, center_px, 5, (0, 0, 255), -1)
                cv2.line(overlay, (int(optical_cx), int(optical_cy)),
                         center_px, (0, 255, 0), 2)
                cv2.putText(overlay, f"ID: {marker_id}   Quadrant: {quadrant}",
                            (15, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.6,
                            (0, 255, 0), 2)
                cv2.putText(overlay,
                            f"Raw angle: {raw_angle_deg:+.2f}   Filtered: {angle_deg:+.2f} deg",
                            (15, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.6,
                            (0, 255, 255), 2)


                if filtered_distance_in is not None:
                    cv2.putText(overlay,
                                f"Distance: {filtered_distance_in:.1f} in  "
                                f"({filtered_distance_in / 12.0:.2f} ft)",
                                (15, 95), cv2.FONT_HERSHEY_SIMPLEX, 0.75,
                                (0, 255, 255), 2)
                    cv2.putText(overlay,
                                f"Raw range: {raw_distance_in:.1f} in  "
                                f"Forward Z: {forward_distance_in:.1f} in",
                                (15, 125), cv2.FONT_HERSHEY_SIMPLEX, 0.55,
                                (255, 255, 255), 2)


                    # This is only a visual status: it DOES NOT stop motors.
                    if filtered_distance_in <= CLOSE_ENOUGH_IN:
                        cv2.putText(overlay,
                                    "WITHIN 1.5 FT (CAMERA TO MARKER CENTER)",
                                    (15, 160), cv2.FONT_HERSHEY_SIMPLEX, 0.65,
                                    (0, 255, 0), 2)
                else:
                    cv2.putText(overlay, "Distance: POSE UNAVAILABLE",
                                (15, 95), cv2.FONT_HERSHEY_SIMPLEX, 0.65,
                                (0, 0, 255), 2)


                if now - last_print_time >= 0.75:
                    if filtered_distance_in is not None:
                        print(f"Marker {marker_id}: angle={angle_deg:+.2f} deg, "
                              f"distance={filtered_distance_in:.1f} in "
                              f"({filtered_distance_in/12:.2f} ft), "
                              f"forward_z={forward_distance_in:.1f} in")
                    else:
                        print("Marker detected, but pose/distance estimation failed")
                    last_print_time = now
                break


        if not target_found:
            cv2.putText(overlay, "Target marker not found", (15, 30),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.65, (0, 0, 255), 2)
            # Don't drag an old reading into a new acquisition.
            filtered_angle = None
            filtered_distance_in = None
            now = time.time()
            if now - last_lcd_time >= 0.25:
                queue_lcd(two_line_lcd("NO MARKER", "Distance: --"))
                last_lcd_time = now


        cv2.imshow("ArUco Bearing + Distance", overlay)
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break
finally:
    camera.release()
    cv2.destroyAllWindows()
    Arduino_bus.close()
