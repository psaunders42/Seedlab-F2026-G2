#include <Wire.h>

void setup() {
  Wire.begin(8);               
  Wire.onReceive(receiveEvent); // Register the receive event
  Serial.begin(9600);           // Start serial for output
  Serial.println("Arduino ready to receive bits...");
}

void loop() {
  delay(100);
}

// This function executes whenever data is received from the Pi
void receiveEvent(int howMany) {
  while (Wire.available()) {
    byte wheelBits = Wire.read(); // Receive the goal_byte
    Serial.print("Received Wheel Bits: ");
    Serial.println(wheelBits);
  }
}
