# Purpose: Creates a grid on the camera, 
# detects what quadrant the ID is in, and communicates what quadrant the ID is in to the Arduino 
#--------------------------------------------------------------------------

import cv2
import cv2.aruco as aruco
import numpy as np
from time import sleep
import board
import adafruit_character_lcd.character_lcd_rgb_i2c as character_lcd
import threading
import queue
from smbus import SMBus

# --------------------------------------------------
# SETTINGS
# --------------------------------------------------

TARGET_ID = 0

ARUCO_DICT = aruco.DICT_6X6_50

DEADBAND_PX = 15

QUADRANT_BITS = {
    "NE": (0, 0),
    "NW": (0, 1),
    "SW": (1, 1),
    "SE": (1, 0),
}

# --------------------------------------------------
# LCD
# --------------------------------------------------
lcdc= 16
lcdr = 2
i2c = board.I2C()

LCDqueue = queue.Queue()
def LCDdisplay():
    sleep(1)
    try:
        lcd = character_lcd.Character_LCD_RGB_I2C(i2c,lcdc,lcdr)
        lcd.clear()
        sleep(0.05)
        lcd.color = [0,0,100]
        while True:
            location = LCDqueue.get()
            lcd.clear()
            lcd.message = "Desied Location:\n" + str(location)
        sleep(0.1)
    except Exception as e:
        print(f"LCD thread error: {e}")

LCDthread = threading.Thread(target = LCDdisplay, args=(),daemon=True)
LCDthread.start()

# --------------------------------------------------
# Ardunio
# --------------------------------------------------

ARD_ADDR = 8
Arduino_bus = SMBus(1)


# --------------------------------------------------
# ARUCO DICTIONARY
# --------------------------------------------------

aruco_dict = aruco.getPredefinedDictionary(ARUCO_DICT)

# --------------------------------------------------
# CAMERA SETUP
# --------------------------------------------------

camera = cv2.VideoCapture("/dev/video0", cv2.CAP_V4L2)

camera.set(
    cv2.CAP_PROP_FOURCC,
    cv2.VideoWriter_fourcc(*"MJPG")
)

camera.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
camera.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
camera.set(cv2.CAP_PROP_FPS, 30)


print("Camera opened:", camera.isOpened())
print("Width:", camera.get(cv2.CAP_PROP_FRAME_WIDTH))
print("Height:", camera.get(cv2.CAP_PROP_FRAME_HEIGHT))
print("FPS:", camera.get(cv2.CAP_PROP_FPS))


# Give camera time to stabilize
sleep(2)


# --------------------------------------------------
# VARIABLES
# --------------------------------------------------

last_quadrant = None


# --------------------------------------------------
# MAIN LOOP
# --------------------------------------------------

while True:
    # Get image from camera
    ret, frame = camera.read()

    if not ret:
        print("Could not read image from camera")
        break


    # Get actual frame size
    frame_height, frame_width = frame.shape[:2]

    # Find center lines
    mid_x = frame_width // 2
    mid_y = frame_height // 2

    # Convert to grayscale
    grey = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)


    # --------------------------------------------------
    # DETECT ARUCO MARKERS
    # --------------------------------------------------

    corners, ids, rejected = aruco.detectMarkers(grey,aruco_dict)

    # Make display image
    overlay = frame.copy()

    # Draw vertical and horizontal center lines
    cv2.line(
        overlay,
        (mid_x, 0),
        (mid_x, frame_height),
        (255, 255, 255),
        1)

    cv2.line(
        overlay,
        (0, mid_y),
        (frame_width, mid_y),
        (255, 255, 255),
        1)


    # --------------------------------------------------
    # CHECK IF ANY MARKERS WERE FOUND
    # --------------------------------------------------

    if ids is not None:

        ids = ids.flatten()

        for outline, marker_id in zip(corners, ids):

            # Ignore markers that aren't our target
            if marker_id != TARGET_ID:
                continue


            # --------------------------------------------------
            # GET MARKER CORNERS
            # --------------------------------------------------

            markerCorners = outline.reshape((4, 2))


            # --------------------------------------------------
            # FIND CENTER OF MARKER
            # --------------------------------------------------

            center_x = int(np.mean(markerCorners[:, 0]))
            center_y = int(np.mean(markerCorners[:, 1]))


            # --------------------------------------------------
            # DETERMINE QUADRANT
            # --------------------------------------------------

            dx = center_x - mid_x
            dy = center_y - mid_y


            # Deadband:
            # If marker is very close to a center line,
            # keep the previous quadrant.

            if abs(dx) <= DEADBAND_PX or abs(dy) <= DEADBAND_PX:

                quadrant = last_quadrant

            else:

                if dx > 0 and dy < 0:
                    quadrant = "NE"

                elif dx < 0 and dy < 0:
                    quadrant = "NW"

                elif dx < 0 and dy > 0:
                    quadrant = "SW"

                else:
                    quadrant = "SE"


            # --------------------------------------------------
            # DRAW MARKER
            # --------------------------------------------------

            overlay = aruco.drawDetectedMarkers(
                overlay,
                [outline],
                np.array([[marker_id]])
            )


            # Draw center of marker
            cv2.circle(
                overlay,
                (center_x, center_y),
                5,
                (0, 0, 255),
                -1
            )


            # Draw line from image center to marker
            cv2.line(
                overlay,
                (mid_x, mid_y),
                (center_x, center_y),
                (0, 255, 0),
                2
            )


            # --------------------------------------------------
            # GET WHEEL BITS
            # --------------------------------------------------

            if quadrant is not None:

                left_bit, right_bit = QUADRANT_BITS[quadrant]

                # Pack the two bits:
                # left = most significant bit
                # right = least significant bit
                goal_byte = (left_bit << 1) | right_bit

            
                # --------------------------------------------------
                # PRINT ONLY WHEN QUADRANT CHANGES
                # --------------------------------------------------

                if quadrant != last_quadrant:

                    print("--------------------------")
                    print("Marker ID:", marker_id)
                    print("Center:", center_x, center_y)
                    print("Quadrant:", quadrant)
                    print("Left:", left_bit)
                    print("Right:", right_bit)
                    print("Goal byte:", goal_byte)
                    print("--------------------------")

                    
                    try:
                        Arduino_bus.write_byte(ARD_ADDR, goal_byte)
                        print("Byte sent to Arduino: ", goal_byte)
                        
                    except OSError as e:
                        print(f"Failed to send to Ardunio: {e}")
                                        
                    last_quadrant = quadrant

                    LCDqueue.put([left_bit, right_bit])

                # --------------------------------------------------
                # DISPLAY INFORMATION
                # --------------------------------------------------

                cv2.putText(
                    overlay,
                    "ID: " + str(marker_id),
                    (center_x - 30, center_y - 35),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.6,
                    (255, 0, 0),
                    2
                )

                cv2.putText(
                    overlay,
                    "Quadrant: " + quadrant,
                    (20, 30),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.7,(0, 255, 0),2)

                cv2.putText(
                    overlay,
                    "L: {}  R: {}".format(left_bit, right_bit),
                    (20, 60),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.7,
                    (0, 255, 0),2)

                cv2.putText(
                    overlay,
                    "Goal: {}".format(goal_byte),
                    (20, 90),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.7,(0, 255, 0),2)

                cv2.putText(
                    overlay,
                    "Center: ({}, {})".format(center_x, center_y),
                    (20, 120),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.6,(255, 255, 255),2)
    # --------------------------------------------------
    # NO MARKER FOUND
    # --------------------------------------------------

    else:

        cv2.putText(
            overlay,
            "Target marker not found",
            (20, 30),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,(0, 0, 255),2)

    # --------------------------------------------------
    # DISPLAY IMAGE
    # --------------------------------------------------

    cv2.imshow("ArUco Quadrant Detection", overlay)

    # Press q to quit
    k = cv2.waitKey(1) & 0xFF

    if k == ord('q'):
        break

# --------------------------------------------------
# CLEAN UP
# --------------------------------------------------

camera.release()
cv2.destroyAllWindows()
